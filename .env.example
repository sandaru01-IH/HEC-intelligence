# LLM Model served by Ollama
# Options: gemma3:4b | qwen2.5vl:3b | mistral:7b | llama3.2:3b
LLM_MODEL=gemma3:4b

# Ollama server URL (default, no change needed)
OLLAMA_BASE_URL=http://localhost:11434

# Embedding model via Ollama (already installed as nomic-embed-text)
EMBEDDING_MODEL=nomic-embed-text

# Number of documents retrieved per query
TOP_K_RETRIEVAL=5
